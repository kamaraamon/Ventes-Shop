{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^typecheck"],
      "outputs": [".next/**", "!.next/cache/**", "public/sw.js", "public/sw.js.map"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "generate": {
      "cache": false
    }
  }
}
